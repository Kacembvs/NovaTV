<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nova" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nova_navy</item>
        <item name="android:statusBarColor">@color/nova_navy</item>
        <item name="android:navigationBarColor">@color/nova_navy</item>
    </style>
    <!-- Player: AppCompat theme required by the Google Cast button / device picker. -->
    <style name="Theme.Nova.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorAccent">@color/nova_cyan</item>
    </style>
</resources>